@@ -0,0 +1,14 @@
+import type { Take } from './model'
+
+/**
+ * C-DIFF-2 (contre-recette QA-V2-DIFF-01) — condition de tempo commune à un groupe de prises comparables,
+ * formulée selon son origine : « même tempo » n’est plus affiché pour des prises en tempo libre.
+ * Libellé seulement : les règles de comparaison (takes.ts) ne changent pas. Le groupe est homogène
+ * (même origine et même valeur de tempo), la première prise suffit. Formulation à confirmer par le Product Design.
+ */
+export function comparisonTempoLabel(t: Pick<Take, 'bpm' | 'refBpm' | 'tempoSource'>) {
+  if (t.tempoSource === 'free') return 'toutes en tempo libre'
+  if (t.tempoSource === 'reference') return `même tempo de référence (${t.refBpm} BPM, sans métronome)`
+  if (t.tempoSource === 'metronome') return `même tempo au métronome (${t.bpm} BPM)`
+  return `même tempo (${t.bpm} BPM)`
+}
