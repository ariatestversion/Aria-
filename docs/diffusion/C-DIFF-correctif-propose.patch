+import { describe, expect, it } from 'vitest'
+import { comparisonTempoLabel } from './labels'
+import { takeTempo } from './takes'
+
+describe('C-DIFF-2 — libellé de la condition de tempo des prises comparables', () => {
+  it('ne dit jamais « même tempo » pour des prises en tempo libre', () => {
+    expect(comparisonTempoLabel({ tempoSource: 'free' })).toBe('toutes en tempo libre')
+  })
+  it('distingue tempo de référence, métronome et prises antérieures', () => {
+    expect(comparisonTempoLabel(takeTempo(undefined, 60, true))).toBe('même tempo de référence (60 BPM, sans métronome)')
+    expect(comparisonTempoLabel(takeTempo(60, 60, true))).toBe('même tempo au métronome (60 BPM)')
+    expect(comparisonTempoLabel({ bpm: 64 })).toBe('même tempo (64 BPM)')
+  })
+})
