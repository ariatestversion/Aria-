     if (goal === 'Rythme') check('S09 · S09-QA-02 : la prise au métronome est écoutée à part (origine du tempo différente)', /Une seule des deux prises a été faite avec le métronome/.test(review11), review11.match(/Autres prises[^\n]*/)?.[0] || '')
     check(`S09 · S09-QA-02 (${goal}) : aucune erreur JavaScript`, p11errors.length === 0, p11errors.join(' | '))
     await b11.close()
@@ -1457,6 +1460,28 @@ async function main() {
     await b14.close()
   }
 
+  // C-DIFF-1 (contre-recette QA-V2-DIFF-01) — l’ancien nom n’apparaît plus : écran de chargement, démarrage échoué,
+  // écran de connexion et ses conditions, /version.json.
+  {
+    const b15 = await chromiumBase.launch()
+    const c15 = await b15.newContext({ viewport: VIEWPORT, locale: 'fr-FR' })
+    const p15 = await c15.newPage()
+    const html = await (await p15.request.get(BASE)).text()
+    check('C-DIFF-1 : écran de chargement et message de démarrage échoué sans « Aria »', !/\bAria\b|\bARIA\b/.test(html) && (html.match(new RegExp(`>${BRAND}</p>`, 'g')) || []).length === 2)
+    const v15 = await (await p15.request.get(new URL('version.json', BASE).href)).json()
+    check('C-DIFF-1 : /version.json porte le nom de marque', v15.name === BRAND, v15.name)
+    await p15.goto(`${BASE}?reset`)
+    await p15.getByRole('button', { name: 'Se connecter' }).click()
+    await p15.waitForTimeout(500)
+    for (const link of ['Conditions d’utilisation', 'Politique de confidentialité']) {
+      const l = p15.getByRole('button', { name: link })
+      if (await l.count()) await l.first().click().catch(() => undefined)
+    }
+    const auth = await p15.evaluate(() => document.body.innerText)
+    check('C-DIFF-1 : écran de connexion et conditions sans « Aria », avec le nom de marque', !/\bAria\b|\bARIA\b/.test(auth) && auth.includes(`Bienvenue sur ${BRAND}`), auth.match(/[^\n]*Aria[^\n]*/)?.[0] || '')
+    await b15.close()
+  }
+
   const failed = results.filter((r) => !r.ok)
   console.log(`\n${results.length - failed.length}/${results.length} vérifications réussies`)
   process.exit(failed.length ? 1 : 0)
